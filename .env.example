# Gradium (Blue) v5 — Docker Compose environment. Copy to `.env`.

# Which provider backs question generation: "gigachat" (Sber, text-only),
# "gemini" (reads slides visually), or "deepseek" (text-only, OpenAI-compatible).
AI_PROVIDER=gigachat

# GigaChat (Sber). GIGACHAT_AUTH_KEY is the base64 "Authorization key" from the
# Sber developer console — exchanged for a short-lived token automatically.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_MAX_TOKENS=4096
GIGACHAT_VERIFY_SSL=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Subscription generation quota (resets each GENERATION_PERIOD: daily|weekly|monthly)
GENERATION_PERIOD=monthly
FREE_GENERATIONS=3
PRO_GENERATIONS=30
MAX_GENERATIONS=60
# Comma-separated admin account emails (can open the /teacher/admin panel)
ADMIN_EMAILS=muhammadjonaslonov4@gmail.com

# REQUIRED: strong random JWT signing key. Generate with `openssl rand -hex 32`.
# The app refuses to boot in production if this is left at the default below.
SECRET_KEY=change-this-secret-key-in-production

# "production" hides /docs and enforces a non-default SECRET_KEY.
# Use "development" locally to re-enable the interactive API docs.
ENVIRONMENT=production
# Set to true ONLY when the API runs behind a reverse proxy you control
# (nginx/Caddy). While port 8000 is exposed directly, keep it false so the
# rate limiter keys on the real socket IP (X-Forwarded-For can be spoofed).
TRUST_PROXY=false

# Abuse/DoS limits (per client IP, per RATE_LIMIT_WINDOW_SECONDS). Defaults are
# sensible; override only if needed.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_AUTH=8
# RATE_LIMIT_AI=6

BACKEND_PORT=8000
FRONTEND_PORT=3000
# CORS_ORIGINS / NEXT_PUBLIC_* MUST match the browser origin of the deployed
# frontend. For a direct IP deploy use e.g. http://90.156.255.209:3000; behind
# a domain+TLS use https://your-domain. Never use "*".
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
