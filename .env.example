# Gradium (Blue) v5 — Docker Compose environment. Copy to `.env`.

# Which provider backs question generation: "gigachat" (Sber, text-only),
# "gemini" (reads slides visually), or "deepseek" (text-only, OpenAI-compatible).
AI_PROVIDER=gigachat

# GigaChat (Sber). GIGACHAT_AUTH_KEY is the base64 "Authorization key" from the
# Sber developer console — exchanged for a short-lived token automatically.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_MAX_TOKENS=4096
GIGACHAT_VERIFY_SSL=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

SECRET_KEY=change-this-secret-key-in-production
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
