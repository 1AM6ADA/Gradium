# ----------------------------------------------------------------------
# Gradium — Docker Compose environment
# Copy this file to `.env` (docker compose loads it automatically):
#   cp .env.example .env
# ----------------------------------------------------------------------

# --- Required: Google Gemini API key for AI quiz generation ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Auth ---
# Use a long random string in production, e.g. `openssl rand -hex 32`
SECRET_KEY=change-this-secret-key-in-production

# --- Ports exposed on the host ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- CORS: origin(s) the browser loads the frontend from ---
CORS_ORIGINS=http://localhost:3000

# --- Browser-facing URLs (baked into the frontend at build time) ---
# Change these if you serve the app from a different host/domain.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
